# ──────────────────────────────────────────────
# Configuração do Bot de Rastreamento
# Copie este arquivo para .env e preencha os valores
# ──────────────────────────────────────────────

# Token do bot gerado pelo @BotFather no Telegram
TELEGRAM_TOKEN=seu_token_aqui

# Chave de API do Seu Rastreio (seurastreio.com.br → Dashboard → Chaves de API)
SEURASTREIO_API_KEY=sua_chave_aqui

# Número máximo de eventos exibidos por consulta (padrão: 5)
MAX_EVENTOS=5

# Timeout das requisições HTTP em segundos (padrão: 20)
REQUEST_TIMEOUT=20

# Nível de log: DEBUG, INFO, WARNING, ERROR (padrão: INFO)
LOG_LEVEL=INFO
